APP_NAME="Almacén RFID"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://almacen-rfid-mvp.test
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_TIMEZONE=America/Mexico_City

LOG_CHANNEL=single
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_DATABASE se deja vacío: usa database/database.sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=480
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Lector RFID: "simulado" para la demo. Un lector real se conecta implementando App\Services\Rfid\LectorRfid.
RFID_LECTOR=simulado

VITE_APP_NAME="${APP_NAME}"
